{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyPromoteAndInspectImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:BatchDeleteImage",
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings"
      ],
      "Resource": "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/secure-health-api"
    }
  ]
}
